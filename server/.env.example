# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5001
NODE_ENV=development

# Database (Neon or Supabase connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Auth. Both need at least 32 characters. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
# Mixed into every PIN/password before hashing, so a leaked database alone cannot be cracked.
# Keep it out of the database and never change it once users exist (they would not be able to log in).
PIN_PEPPER=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=1d

# Client
CLIENT_URL=http://localhost:5173
